📦 multimodal/image_gen.py
========================================================
from diffusers import StableDiffusionPipeline
import torch

class ImageGenerator:
    def __init__(self, model_id="runwayml/stable-diffusion-v1-5"):
        self.device = "cuda" if torch.cuda.is_available() else "cpu"

        self.pipe = StableDiffusionPipeline.from_pretrained(
            model_id,
            torch_dtype=torch.float16 if self.device == "cuda" else torch.float32
        ).to(self.device)

        if self.device == "cuda":
            self.pipe.enable_attention_slicing()

    @torch.no_grad()
    def generate(self, prompt, steps=30):
        result = self.pipe(
            prompt=prompt,
            num_inference_steps=steps
        )
        return result.images[0]
========================================================
📦 multimodal/video_gen.py
========================================================
from diffusers import DiffusionPipeline
import torch

class VideoGenerator:
    def __init__(self, model_id="damo-vilab/text-to-video-ms-1.7b"):
        self.device = "cuda" if torch.cuda.is_available() else "cpu"

        self.pipe = DiffusionPipeline.from_pretrained(
            model_id,
            torch_dtype=torch.float16 if self.device == "cuda" else torch.float32
        ).to(self.device)

        if self.device == "cuda":
            self.pipe.enable_model_cpu_offload()

    @torch.no_grad()
    def generate(self, prompt, num_frames=16):
        result = self.pipe(prompt)
        return result.frames[:num_frames]
========================================================
📦 multimodal/orchestrator.py
========================================================
from multimodal.code_agent import CodeAgent
from multimodal.image_gen import ImageGenerator
from multimodal.video_gen import VideoGenerator

class MultimodalSystem:

    def __init__(self):
        self.code = CodeAgent()
        self.image = ImageGenerator()
        self.video = VideoGenerator()

    def run(self, task: dict):

        task_type = task.get("type")
        prompt = task.get("prompt", "")

        if not task_type:
            return {"error": "missing task type"}

        if task_type == "code":
            return {"output": self.code.generate(prompt)}

        if task_type == "image":
            img = self.image.generate(prompt)
            return {"output": img}

        if task_type == "video":
            vid = self.video.generate(prompt)
            return {"output": vid}

        return {"error": f"unknown task type: {task_type}"}
========================================================
📦 distributed/multimodal_workers.py
========================================================
import ray
from multimodal.orchestrator import MultimodalSystem

@ray.remote(num_gpus=1)
class MultiWorker:

    def __init__(self):
        self.system = MultimodalSystem()

    def run(self, task: dict):
        return self.system.run(task)
========================================================
📦 api/multimodal.py
========================================================
from fastapi import APIRouter
import ray
from distributed.multimodal_workers import MultiWorker

router = APIRouter()

worker = None

@router.on_event("startup")
def startup():
    global worker
    if not ray.is_initialized():
        ray.init(ignore_reinit_error=True)

    worker = MultiWorker.remote()

@router.post("/generate")
async def generate(task: dict):
    result = await worker.run.remote(task)
    return {"result": result}
========================================================
📦 frontend/multimodal.js
========================================================
export async function generate(task) {
  const res = await fetch("/generate", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify(task)
  });

  if (!res.ok) {
    throw new Error("Request failed");
  }

  return await res.json();
}
========================================================
📦 main/multimodal_step.py
========================================================
def multimodal_step(agent_system, multimodal_system, task):

    decision = agent_system.plan(task)

    if decision.get("mode") == "create":

        result = multimodal_system.run({
            "type": decision.get("type"),
            "prompt": decision.get("prompt")
        })

        return result

    return {"status": "no action"}
